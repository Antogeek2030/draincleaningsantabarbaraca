---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, EMAIL, ADDRESS } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Contact Us | ${SITE_TITLE}`} description="Request a free drain cleaning quote or ask a question. Serving Santa Barbara, CA. Call or use our contact form." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Contact Us</h1>
			<p>Request a free quote or ask a question. We respond quickly to Santa Barbara customers.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Get in Touch</h2>
					<p><strong>Phone:</strong> <a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
					<p><strong>Email:</strong> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
					<p><strong>Address:</strong> {ADDRESS}</p>
					<p><strong>Service Area:</strong> Santa Barbara, CA and nearby communities including Goleta, Carpinteria, Montecito, Summerland, and the greater Santa Barbara region.</p>
					<p>Prefer to talk? Call us during business hours for the fastest response. For emergencies, leave a message and we will get back to you as soon as possible.</p>
					<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call Now</a>

					<div class="mt-2">
						<h3>Find Us</h3>
						<div class="map-wrapper">
							<iframe
								src="https://maps.google.com/maps?q=6+W+Figueroa+St+%23213,+Santa+Barbara,+CA+93101&t=&z=15&ie=UTF8&iwloc=&output=embed"
								title="Map showing our location at 6 W Figueroa St #213, Santa Barbara, CA 93101"
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen
							></iframe>
						</div>
					</div>
				</div>
				<div>
					<h2>Request a Free Quote</h2>
					<form method="POST" action="https://formspree.io/f/YOUR_FORM_ID" class="contact-form">
						<div class="form-group">
							<label for="name">Full Name *</label>
							<input type="text" id="name" name="name" required placeholder="Your name" />
						</div>
						<div class="form-group">
							<label for="phone">Phone *</label>
							<input type="tel" id="phone" name="phone" required placeholder="(805) 555-0000" />
						</div>
						<div class="form-group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" placeholder="you@example.com" />
						</div>
						<div class="form-group">
							<label for="service">Service Needed</label>
							<select id="service" name="service">
								<option value="">Select a service</option>
								<option value="drain-cleaning">Drain Cleaning</option>
								<option value="clogged-drain">Clogged Drain Repair</option>
								<option value="hydro-jetting">Hydro Jetting</option>
								<option value="camera-inspection">Camera Inspection</option>
								<option value="emergency">Emergency Service</option>
								<option value="other">Other / Not Sure</option>
							</select>
						</div>
						<div class="form-group">
							<label for="message">Message / Details</label>
							<textarea id="message" name="message" rows="4" placeholder="Tell us about the issue..."></textarea>
						</div>
						<button type="submit" class="btn btn-primary">Send Request</button>
					</form>
					<p class="form-note">Replace YOUR_FORM_ID in the form action with your Formspree endpoint.</p>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</body>
</html>
