---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Hydro Jetting Santa Barbara | ${SITE_TITLE}`} description="Professional hydro jetting services in Santa Barbara. High-pressure water cleaning for drains and sewer lines." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Hydro Jetting Services</h1>
			<p>Powerful, thorough cleaning that restores pipes from the inside out.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>What is Hydro Jetting?</h2>
					<p>Hydro jetting uses high-pressure water streams to scour the interior of drain and sewer pipes. Unlike traditional snaking, which punches a hole through a clog, hydro jetting removes grease, scale, roots, and debris from the entire pipe wall — restoring near-original capacity.</p>
					
					<h3>When Hydro Jetting is Recommended</h3>
					<ul>
						<li>Recurring clogs in the same line</li>
						<li>Grease-laden commercial kitchen drains</li>
						<li>Root intrusion in older sewer lines</li>
						<li>Preventive maintenance for main lines</li>
						<li>After camera inspection reveals heavy buildup</li>
					</ul>

					<p>Our technicians adjust pressure carefully to protect older or fragile pipes while still delivering effective cleaning. Hydro jetting is safe for most modern plumbing systems when performed by trained professionals.</p>
					<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
				</div>
				<div>
					<h3>Benefits</h3>
					<ul>
						<li>Removes years of buildup</li>
						<li>Longer-lasting results than snaking alone</li>
						<li>Environmentally friendly (no harsh chemicals)</li>
						<li>Improves flow and reduces odors</li>
					</ul>
					<a href="/contact/" class="btn btn-secondary">Get a Quote</a>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Ready for a Deep Clean?</h2>
			<p>Schedule hydro jetting in Santa Barbara today.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
