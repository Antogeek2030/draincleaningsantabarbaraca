---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Emergency Drain Cleaning Santa Barbara | ${SITE_TITLE}`} description="24/7 emergency drain cleaning and clogged drain service in Santa Barbara. Fast response for backups and overflows." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Emergency Drain Service</h1>
			<p>When drains back up or overflow, we’re ready to respond — day or night.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Fast Response for Drain Emergencies</h2>
					<p>A backed-up toilet, overflowing sink, or sewage smell is more than inconvenient — it can damage flooring, walls, and belongings and create health hazards. Our emergency drain cleaning team prioritizes urgent calls in Santa Barbara and nearby areas.</p>
					
					<h3>We Handle</h3>
					<ul>
						<li>Overflowing toilets and sinks</li>
						<li>Sewage backups</li>
						<li>Multiple fixture clogs (sign of main line issue)</li>
						<li>Commercial kitchen drain emergencies</li>
						<li>After-hours and weekend service</li>
					</ul>

					<p>Call us immediately if you have standing water, sewage odors, or drains that won’t clear. We’ll guide you on temporary steps while we dispatch a technician.</p>
					<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE} for Emergency</a>
				</div>
				<div>
					<h3>What to Do While You Wait</h3>
					<ul>
						<li>Stop using water in the affected area</li>
						<li>Do not flush toilets if the main line is backed up</li>
						<li>Keep children and pets away from standing water</li>
						<li>Note any unusual odors or sounds</li>
					</ul>
					<a href="/contact/" class="btn btn-secondary">Contact Us</a>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Drain Emergency? Call Now</h2>
			<p>We’re here when you need us most in Santa Barbara.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
