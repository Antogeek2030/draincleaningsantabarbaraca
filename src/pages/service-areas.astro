---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, ADDRESS } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Service Areas | ${SITE_TITLE}`} description="Drain cleaning and clogged drain repair serving Santa Barbara, Goleta, Carpinteria, Montecito, and the greater Santa Barbara area in California." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Service Areas</h1>
			<p>Proudly serving Santa Barbara and the surrounding Central Coast communities.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Where We Work</h2>
					<p>We are a local company focused on residential and commercial drain cleaning services throughout the Santa Barbara region. We understand the unique plumbing challenges here — from older homes with aging pipes to coastal properties — and we service systems accordingly.</p>
					
					<h3>Primary Service Areas</h3>
					<ul>
						<li><strong>Santa Barbara, CA</strong> — Our home base. Full service for all neighborhoods.</li>
						<li>Goleta, CA</li>
						<li>Carpinteria, CA</li>
						<li>Montecito, CA</li>
						<li>Summerland, CA</li>
						<li>Isla Vista</li>
						<li>Hope Ranch and nearby communities</li>
					</ul>
					
					<h3>Not Sure If We Cover Your Area?</h3>
					<p>If you live near Santa Barbara and need drain cleaning, clogged drain repair, or a camera inspection, give us a call. We often serve additional nearby communities and will let you know quickly if we can help.</p>
				</div>
				<div>
					<h3>Our Location</h3>
					<p>{ADDRESS}</p>
					<div class="map-wrapper mt-2">
						<iframe
							src="https://maps.google.com/maps?q=6+W+Figueroa+St+%23213,+Santa+Barbara,+CA+93101&t=&z=15&ie=UTF8&iwloc=&output=embed"
							title="Map showing 6 W Figueroa St #213, Santa Barbara, CA 93101"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Serving Your Neighborhood</h2>
			<p>Call today to schedule drain cleaning service in Santa Barbara or nearby communities.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
